<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ spec.title }}</title>
<style>
  :root { color-scheme: light; }
  * { box-sizing: border-box; }
  body {
    margin: 0 auto; padding: 32px 28px 48px; max-width: 980px;
    font-family: "Segoe UI", "Microsoft YaHei", "PingFang SC", system-ui, sans-serif;
    color: #24303b; background: #fff; line-height: 1.65; font-size: 14px;
  }
  h1 { font-size: 30px; line-height: 1.25; margin: 8px 0 6px; }
  h2 { font-size: 19px; margin: 0 0 12px; padding-bottom: 8px; border-bottom: 2px solid #eef1f4; }
  .eyebrow { color: #4f7cac; font-size: 12px; letter-spacing: .12em; text-transform: uppercase; font-weight: 700; }
  .subtitle { color: #5f6b76; font-size: 15px; margin: 0 0 14px; }
  .meta { display: flex; flex-wrap: wrap; gap: 8px 18px; color: #7a8590; font-size: 12px; margin-bottom: 12px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0 6px; }
  .chip { background: #f1f4f7; border: 1px solid #e3e8ed; border-radius: 999px; padding: 3px 11px; font-size: 11px; color: #44515d; }
  .block { margin: 30px 0; page-break-inside: avoid; }
  .text { white-space: pre-wrap; margin: 0; }
  table { border-collapse: collapse; width: 100%; font-size: 12px; margin: 10px 0; }
  th, td { border: 1px solid #dfe4ea; padding: 7px 9px; text-align: left; vertical-align: top; }
  th { background: #f4f6f8; color: #44515d; font-weight: 700; white-space: nowrap; }
  td { overflow-wrap: anywhere; }
  tbody tr:nth-child(even) td { background: #fafbfc; }
  .chart { display: block; max-width: 100%; margin: 14px auto 6px; border: 1px solid #e3e6ea; border-radius: 8px; }
  .source { color: #7a8590; font-size: 11px; margin: 8px 0 0; }
  .warn { color: #9a5b00; background: #fff8e8; border: 1px solid #f0dfb8; border-radius: 8px; padding: 8px 12px 8px 28px; font-size: 12px; }
  .note { color: #7a8590; font-size: 11px; }
  .appendix { margin-top: 40px; page-break-before: always; }
  .appendix table { font-size: 10.5px; }
  .disclaimer { margin-top: 32px; padding: 12px 14px; border-radius: 8px; background: #f6f7f9; color: #5f6b76; font-size: 12px; }
  @page { size: A4; margin: 16mm; }
  @media print {
    body { padding: 0; max-width: none; }
    .block { page-break-inside: avoid; }
    .appendix { page-break-before: always; }
  }
</style>
</head>
<body>
{% macro table(columns, rows, limit) -%}
<table>
  <thead><tr>{% for c in columns %}<th>{{ c }}</th>{% endfor %}</tr></thead>
  <tbody>
  {% for row in rows[:limit] %}
    <tr>{% for cell in row %}<td>{{ '—' if cell is none else cell }}</td>{% endfor %}</tr>
  {% endfor %}
  </tbody>
</table>
{% if rows|length > limit %}
<p class="note">仅展示前 {{ limit }} 行，共 {{ rows|length }} 行；完整数据见 Excel 导出。</p>
{% endif %}
{%- endmacro %}

<header>
  <div class="eyebrow">Oh EcoFin Agent · 数据分析报告</div>
  <h1>{{ spec.title }}</h1>
  {% if spec.subtitle %}<p class="subtitle">{{ spec.subtitle }}</p>{% endif %}
  <div class="meta">
    <span>报告 ID：{{ spec.report_id }}</span>
    <span>生成时间：{{ spec.created_at }}</span>
    <span>spec_hash：{{ spec.spec_hash }}</span>
    <span>block 数：{{ spec.blocks|length }}</span>
  </div>
  {% if spec.datasets %}
  <div class="chips">
    {% for d in spec.datasets %}
    <span class="chip">{{ d.name }} · v{{ d.version }} · {{ d.sha256[:12] }}…</span>
    {% endfor %}
  </div>
  {% endif %}
</header>

{% for block in spec.blocks %}
<section class="block">
  <h2>{{ block.title }}</h2>

  {% if block.type == 'text' %}
    <p class="text">{{ block.text }}</p>
  {% elif block.type == 'sql' %}
    {{ table(block.columns, block.rows, spec.max_table_rows) }}
    {% if block.truncated %}<p class="note">结果已按上限截断，共 {{ block.row_count }} 行。</p>{% endif %}
  {% else %}
    {{ table(block.data.table.columns, block.data.table.rows, spec.max_table_rows) }}
    {% if block.chart_image and chart_images.get(block.id) %}
    <img class="chart" src="{{ chart_images.get(block.id) }}" alt="{{ block.title }}">
    {% endif %}
  {% endif %}

  {% if block.warnings %}
  <ul class="warn">
    {% for w in block.warnings %}<li>{{ w }}</li>{% endfor %}
  </ul>
  {% endif %}

  <p class="source">
    {% if block.source.type == 'analysis' %}
    数据来源：{{ block.source.dataset_name }} v{{ block.source.dataset_version }}
    · sha256 {{ block.source.dataset_sha256[:16] }}…
    · 模块 {{ block.source.module }}
    · result_hash {{ block.source.result_hash }}
    {% if block.source.chart_spec_hash %}· chart_spec {{ block.source.chart_spec_hash }}{% endif %}
    {% elif block.source.type == 'sql' %}
    SQL 只读查询 · sql_hash {{ block.source.sql_hash }}
    · result_hash {{ block.source.result_hash }}
    {% else %}
    叙述文本（非统计证据，数字审计见 M7）
    {% endif %}
  </p>
</section>
{% endfor %}

<section class="appendix">
  <h2>证据与来源</h2>
  <table>
    <thead>
      <tr><th>块</th><th>类型</th><th>数据集</th><th>版本</th><th>sha256</th>
          <th>result_hash</th><th>chart/sql hash</th></tr>
    </thead>
    <tbody>
      {% for s in spec.sources %}
      <tr>
        <td>{{ s.block_id }} · {{ s.block_title }}</td>
        <td>{{ s.type }}</td>
        <td>{{ s.dataset_name or '—' }}</td>
        <td>{{ s.dataset_version or '—' }}</td>
        <td>{{ (s.dataset_sha256 or '—')[:20] }}</td>
        <td>{{ s.result_hash or '—' }}</td>
        <td>{{ s.chart_spec_hash or s.sql_hash or '—' }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  <p class="note">以上哈希由服务端对数据集快照、分析参数与结果计算；同一输入重跑应得到相同哈希。</p>
</section>

<div class="disclaimer">{{ spec.disclaimer }}</div>
</body>
</html>
