{
  "version": "4.0",
  "description": "20 个标准任务（14.2）：投研 8 / 投顾 6 / 量化 6。每组任务含 prompt、期望工具集合（召回率分母）、rubric 要点、ground-truth 数字锚点（供数字准确率比对）。",
  "groups": [
    {
      "id": "research",
      "name": "智能投研",
      "tasks": [
        {
          "id": "r1",
          "prompt": "600519 现在多少钱？简单说下量比和换手。",
          "expected_tools": ["get_quote"],
          "rubric": ["给出现价", "给出量比或换手", "标注数据截至时间"],
          "anchors": {"symbol": "600519"}
        },
        {
          "id": "r2",
          "prompt": "000001 近 120 日走势如何？均线多空排列吗？",
          "expected_tools": ["get_kline", "get_indicator"],
          "rubric": ["调用K线工具", "给出趋势方向", "引用区间涨跌幅或均线"],
          "anchors": {"symbol": "000001"}
        },
        {
          "id": "r3",
          "prompt": "对比 600519、000858、601318 三只股票现价与涨跌幅。",
          "expected_tools": ["get_quote"],
          "rubric": ["一次性并行查询三只", "每只给出现价与涨跌幅"],
          "anchors": {"symbols": ["600519", "000858", "601318"]}
        },
        {
          "id": "r4",
          "prompt": "600519 和 300750 近 120 日收盘价相关性怎么样？",
          "expected_tools": ["get_correlation"],
          "rubric": ["调用相关性工具", "给出相关系数数值", "解读强弱"],
          "anchors": {"symbols": ["600519", "300750"]}
        },
        {
          "id": "r5",
          "prompt": "600519 最近 24 小时有什么新闻？情绪如何？",
          "expected_tools": ["search_news"],
          "rubric": ["调用新闻工具", "汇总情绪方向", "新闻条数≥1"],
          "anchors": {"symbol": "600519", "hours": 24}
        },
        {
          "id": "r6",
          "prompt": "000333 最近有什么消息面？帮我汇总一下。",
          "expected_tools": ["search_news"],
          "rubric": ["调用新闻工具", "聚合情绪分", "不编造新闻标题"],
          "anchors": {"symbol": "000333", "hours": 24}
        },
        {
          "id": "r7",
          "prompt": "600519 值得买吗？请给我一份完整的多空研判。",
          "expected_tools": ["get_quote", "get_kline", "search_news"],
          "rubric": ["DataPack 数据带编号", "多空双方论据", "风控审查记录", "报告含免责声明"],
          "anchors": {"symbol": "600519", "verdict_in": ["bullish", "bearish", "neutral", "watch"]}
        },
        {
          "id": "r8",
          "prompt": "研判一下 601318 现在能不能买。",
          "expected_tools": ["get_quote", "get_kline", "search_news"],
          "rubric": ["结论方向明确", "每个数字有 [n] 引用", "含 risk_disclosure"],
          "anchors": {"symbol": "601318", "verdict_in": ["bullish", "bearish", "neutral", "watch"]}
        }
      ]
    },
    {
      "id": "advisor",
      "name": "智能投顾",
      "tasks": [
        {
          "id": "a1",
          "prompt": "帮我做一个风险测评。",
          "profile_answers": [
            {"qid": "q1", "choice": "没投资过，第一次接触"},
            {"qid": "q2", "choice": "稳稳跑赢存款就行（0-3%）"},
            {"qid": "q3", "choice": "无法接受，立即清仓不再投资"},
            {"qid": "q4", "choice": "1 年以内"},
            {"qid": "q5", "choice": "没有应急资金"}
          ],
          "expected_level": "R1",
          "expected_tools": ["ask_risk_question"],
          "rubric": ["通过 ask_user 挂起提问", "5 题答毕", "等级判定 R1", "说明权益上限 0%"]
        },
        {
          "id": "a2",
          "prompt": "我想做下风险测评，我工作三年了。",
          "profile_answers": [
            {"qid": "q1", "choice": "1-3 年"},
            {"qid": "q2", "choice": "略高于通胀（3-6%）"},
            {"qid": "q3", "choice": "先观察一段时间再决定"},
            {"qid": "q4", "choice": "3 年以上"},
            {"qid": "q5", "choice": "3-6 个月"}
          ],
          "expected_level": "R3",
          "expected_tools": ["ask_risk_question"],
          "rubric": ["上下文感知追问（收入稳定性）", "等级判定 R3", "权益上限 35%"]
        },
        {
          "id": "a3",
          "prompt": "给孩子攒教育金，帮我配个组合。先测评吧。",
          "profile_answers": [
            {"qid": "q1", "choice": "1 年以内"},
            {"qid": "q2", "choice": "接近市场平均（6-10%）"},
            {"qid": "q3", "choice": "按计划继续持有"},
            {"qid": "q4", "choice": "3 年以上"},
            {"qid": "q5", "choice": "12 个月以上"}
          ],
          "expected_level": "R4",
          "expected_tools": ["ask_risk_question", "portfolio_optimize"],
          "rubric": ["期限题措辞自适应（教育金）", "R4 判定", "给出有效前沿图", "当前配置点高亮"]
        },
        {
          "id": "a4",
          "prompt": "我做风险测评，我是老股民，能承受大波动。",
          "profile_answers": [
            {"qid": "q1", "choice": "5 年以上"},
            {"qid": "q2", "choice": "追求高收益，接受大幅波动（15%+）"},
            {"qid": "q3", "choice": "反而考虑逢低加仓"},
            {"qid": "q4", "choice": "3 年以上"},
            {"qid": "q5", "choice": "6-12 个月"}
          ],
          "expected_level": "R5",
          "expected_tools": ["ask_risk_question", "portfolio_optimize"],
          "rubric": ["R5 判定", "单一资产上限 30%", "组合含合规审查通过"]
        },
        {
          "id": "a5",
          "prompt": "测评一下吧，我平时不太懂投资。",
          "profile_answers": [
            {"qid": "q1", "choice": "没投资过，第一次接触"},
            {"qid": "q2", "choice": "略高于通胀（3-6%）"},
            {"qid": "q3", "choice": "卖出大部分，只留少量观察"},
            {"qid": "q4", "choice": "1-3 年"},
            {"qid": "q5", "choice": "3 个月以内"}
          ],
          "expected_level": "R2",
          "expected_tools": ["ask_risk_question"],
          "rubric": ["R2 判定", "权益上限 10%"]
        },
        {
          "id": "a6",
          "prompt": "假设我是 R4，帮我优化 [600519, 000001, 601318, 300750, 510300] 的组合。",
          "profile_answers": [],
          "expected_level": "R4",
          "expected_tools": ["portfolio_optimize"],
          "rubric": ["调用优化工具", "给出权重表", "合规链输出", "含免责声明"],
          "anchors": {"symbols": ["600519", "000001", "601318", "300750", "510300"]}
        }
      ]
    },
    {
      "id": "quant",
      "name": "量化分析",
      "tasks": [
        {
          "id": "q1",
          "prompt": "对 000001 跑一次双均线回测，参数 5/20。",
          "expected_tools": ["run_backtest"],
          "rubric": ["调用回测工具", "给出夏普/最大回撤/胜率", "说明A股规则假设"],
          "anchors": {"symbol": "000001", "fast": 5, "slow": 20}
        },
        {
          "id": "q2",
          "prompt": "600519 用 10/60 双均线回测近两年表现如何？",
          "expected_tools": ["run_backtest"],
          "rubric": ["回测指标完整", "交易次数>0", "提醒后复权口径"],
          "anchors": {"symbol": "600519", "fast": 10, "slow": 60}
        },
        {
          "id": "q3",
          "prompt": "对 000001 做 walk-forward 滚动验证，告诉我样本内外差别。",
          "expected_tools": ["walk_forward"],
          "rubric": ["调用 walk-forward", "逐折衰减率", "解读过拟合"],
          "anchors": {"symbol": "000001", "n_folds": 4}
        },
        {
          "id": "q4",
          "prompt": "用 [600519,000001,000858,601318,300750,000333,002415,601012,600036,601888] 做一次多因子 IC 验证。",
          "expected_tools": ["factor_analysis"],
          "rubric": ["调用因子工具", "给出 IC 表", "指出显著因子"],
          "anchors": {"n_symbols": 10}
        },
        {
          "id": "q5",
          "prompt": "因子分析一下 [600519,600036,000858,601318,601888,300750,002415,601012,000333,000001] 哪些因子有效？",
          "expected_tools": ["factor_analysis"],
          "rubric": ["IC 的 t 统计量", "|t|>2 显著性判断", "MAD+Z 处理说明"],
          "anchors": {"n_symbols": 10}
        },
        {
          "id": "q6",
          "prompt": "你们的回测考虑了印花税和 T+1 吗？怎么建模的？",
          "expected_tools": [],
          "rubric": ["印花税 0.05% 仅卖出", "T+1 账本", "涨跌停跳过下单", "佣金万2.5最低5元"],
          "anchors": {"stamp_duty": 0.0005, "commission": 0.00025, "min_commission": 5.0}
        }
      ]
    }
  ]
}
