# Oh EcoFin Agent 密钥占位文件（真实密钥优先走 Windows 凭据管理器 keyring）
# 复制为 .env 后填写；.env 已被 gitignore，绝不入库。
# 三级读取优先级：环境变量 FINAGENT_* → keyring（服务名 oh-ecofin-agent）→ 本 .env

# GLM（智谱）API Key —— primary 模型 GLM-5.3-Flash
FINAGENT_GLM_KEY=

# DeepSeek API Key —— economy 模型 deepseek-flash
FINAGENT_DEEPSEEK_KEY=

# 博查（Bocha）搜索 API Key —— 搜索三源首选
FINAGENT_BOCHA_KEY=

# 智谱 Web Search（与 GLM 同 key 时可留空）
FINAGENT_ZHIPU_SEARCH_KEY=

# 局域网访问令牌（留空则开启局域网模式时自动随机生成）
FINAGENT_LAN_TOKEN=

# 实盘券商通道（默认关闭；教学演示务必保持 0）
# QMT: BROKER_KIND=qmt + ACCOUNT_ID + QMT_PATH（miniQMT userdata_mini 路径）
# HTTP: BROKER_KIND=http + HTTP_BASE_URL + HTTP_TOKEN（券商 OpenAPI 网关）
FINAGENT_EXECUTION__LIVE_ENABLED=0
FINAGENT_EXECUTION__BROKER_KIND=qmt
FINAGENT_EXECUTION__ACCOUNT_ID=
FINAGENT_EXECUTION__QMT_PATH=
FINAGENT_EXECUTION__QMT_SESSION_ID=0
FINAGENT_EXECUTION__HTTP_BASE_URL=
FINAGENT_EXECUTION__HTTP_TOKEN=
